<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SpotifyApiTopConsoleApp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>SpotifyApiTopConsoleApp.Program</StartupObject>
    <ApplicationIcon>spotify-icon-png-15404-Windows.ico</ApplicationIcon>
    <AssemblyName>SpotifyTop</AssemblyName>
    <UserSecretsId>f644e1e9-1ccb-40a6-ac6e-68cb9b726bc8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="spotify-icon-png-15404-Windows.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="SpotifyAPI.Web" Version="6.2.2" />
    <PackageReference Include="SpotifyAPI.Web.Auth" Version="6.2.2" />
  </ItemGroup>

</Project>
